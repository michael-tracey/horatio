# Horatio's production settings: a blank sample.
#
# How to use it:
#   1. cp deploy/production.env.example deploy/production.env
#      production.env is gitignored: never commit it, and never paste it into chat.
#   2. Fill in each value, following the notes above it. Write values plainly, with
#      no quotes and no spaces around the "=", for example HORATIO_SMTP_PORT=587
#   3. Run deploy/deploy.sh. It copies the settings to the server, where they become
#      the app's environment (/opt/docker-apps/horatio/app.env, mode 600). See
#      deploy/README.md.
#
# A setting left empty is left out, and the app uses its own default (for Discord
# and email, it stays switched off). Horatio reads its settings when it starts, so
# after changing one, redeploy with `deploy/deploy.sh --no-build`.
#
# Set for you, so don't add them here (they'd be ignored):
#   HORATIO_DATABASE_URL     by the playbook, from HORATIO_DB_PASSWORD
#   HORATIO_COOKIE_SECURE    by the playbook: true, sign-in cookies only over HTTPS
#   HORATIO_UPLOAD_DIR       by the playbook: /uploads, uploaded pictures
#   HORATIO_BACKUP_DIR       by the playbook: /backups, nightly and custodian backups
#   HORATIO_DARK_PACK_DIR    by the playbook: /dark-pack, Dark Pack resources if imported
#   HORATIO_FRONTEND_DIST    by the Dockerfile: the built frontend
#   HORATIO_COMMIT, HORATIO_BUILT_AT   by deploy.sh, baked into the image


# === Required ====================================================================
# deploy.sh stops before deploying if any of these three is empty.

# The password of the horatio database, which the playbook creates on the first
# deploy. Make a long random one with `openssl rand -hex 24` (at least 16
# characters).
# NEVER change it after the first deploy: Postgres keeps the password it was
# created with, and the app would no longer be able to connect.
HORATIO_DB_PASSWORD=

# The site's address, with https:// and no slash at the end, for example
# https://horatio.example.org
# Links in emails and Discord messages point here, and Discord sends people back to
# <this address>/api/discord/callback. It must name the same host as `domain` in
# deploy/playbook.yml, which nginx and the TLS certificate use.
HORATIO_PUBLIC_URL=

# An address of yours where Let's Encrypt writes about the site's TLS certificate,
# such as warnings before it expires. certbot uses it on the server; the app
# doesn't. Example: ops@example.org
HORATIO_LETSENCRYPT_EMAIL=


# === Email (optional) ============================================================
# Horatio sends from one address of its own, through one SMTP service:
#   - password reset links and email-change confirmations;
#   - notification emails;
#   - downtime results, for troupes that use the email connector.
# Email stays switched off until both HORATIO_SMTP_HOST and HORATIO_MAIL_FROM are
# set.
#
# Any mail provider that offers SMTP works. In its settings, look for "SMTP",
# "SMTP relay" or "SMTP credentials". It gives you a server name, a port, a
# username and a password; some call the password an "API key" or an "app
# password". Before it sends for your address, the provider usually asks you to
# verify the sending domain with SPF and DKIM records. Do that, or mail lands in
# spam.

# The SMTP server's name, from your provider. Example: smtp.example.org
HORATIO_SMTP_HOST=

# The port and how the connection is secured. Pick one of these two pairs, never
# both:
#   port 587:  HORATIO_SMTP_STARTTLS=true    HORATIO_SMTP_SSL=false   (the default below)
#   port 465:  HORATIO_SMTP_SSL=true         HORATIO_SMTP_STARTTLS=false
HORATIO_SMTP_PORT=587
HORATIO_SMTP_STARTTLS=true
HORATIO_SMTP_SSL=false

# The account to sign in as, and its password or API key, from your provider.
# Leave both empty only if your SMTP server takes mail without signing in.
# The password is a secret. It stays in this file and on the server, and Horatio
# never shows it or stores it in its database.
HORATIO_SMTP_USERNAME=
HORATIO_SMTP_PASSWORD=

# The address mail comes from, with a name, for example
# Horatio <horatio@example.org>
# It must be an address, or on a domain, that your provider lets you send from.
HORATIO_MAIL_FROM=


# === Discord (optional) ==========================================================
# One Discord bot serves the whole site. Each troupe adds it to its own Discord
# server to get downtime results, news and announcements there. Discord stays
# switched off until all three settings are set.
#
# To make the bot:
#   1. Go to https://discord.com/developers/applications and choose
#      "New Application". Its name is the bot's name in every troupe's server, so
#      "Horatio" or your site's name works well.
#   2. Open "Bot". Choose "Reset Token" and copy the token straight away, because
#      Discord shows it only once. It goes in HORATIO_DISCORD_BOT_TOKEN.
#      - Leave "Public Bot" on, so troupes can add the bot to their servers.
#      - Leave the privileged intents off: Horatio needs none of them.
#   3. Open "OAuth2". Copy the Client ID into HORATIO_DISCORD_CLIENT_ID. Copy the
#      Client Secret into HORATIO_DISCORD_CLIENT_SECRET; reset it if it's hidden.
#   4. Still under "OAuth2", add this redirect and save:
#        <HORATIO_PUBLIC_URL>/api/discord/callback
#      for example https://horatio.example.org/api/discord/callback. It must match
#      HORATIO_PUBLIC_URL exactly, https and all.
#   5. You don't need to make an invite link. Horatio makes its own when a troupe's
#      staff add the bot, and it asks only to see channels and send messages.
#
# The client secret and the bot token are secrets: anyone who has them can act as
# your bot. They stay in this file and on the server, and Horatio never shows them.
HORATIO_DISCORD_CLIENT_ID=
HORATIO_DISCORD_CLIENT_SECRET=
HORATIO_DISCORD_BOT_TOKEN=


# === Suspended accounts (optional) ===============================================
# How someone whose account is suspended can reach you: an email address or a web
# page. It's shown when they try to sign in. Left empty, they're told only to
# contact the custodian. Example: custodian@example.org
HORATIO_CUSTODIAN_CONTACT=


# === Fine-tuning (optional; the defaults suit most sites) =========================
# Remove the "#" to set one.

# How many days a sign-in lasts before people must sign in again. Default 30.
# HORATIO_SESSION_DAYS=30

# How often, in seconds, waiting Discord and email deliveries are sent. Default 15.
# HORATIO_DELIVERY_INTERVAL=15

# Where Horatio's source code lives, used by the custodian's "What is running" to
# link a build to its commit. Change it if you run your own copy of the code.
# HORATIO_SOURCE_URL=https://github.com/michael-tracey/horatio


# === After deploying =============================================================
# Sign in as the custodian and open Custodian > Site. The Mail card and the
# Discord card say whether each is working, without showing any secret. They also
# let you send a test email and check the bot.
# Until those cards are there, open any troupe's Customise > Connectors: Discord
# and email no longer say they aren't set up.
