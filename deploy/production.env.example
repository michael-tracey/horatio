# Horatio's production settings. Copy to deploy/production.env (gitignored) and
# fill in. deploy.sh copies it to the host, where it becomes the app's
# environment; see deploy/README.md.

# --- Required -------------------------------------------------------------------

# The Postgres password for the horatio database on the host. Make a long random
# one (e.g. `openssl rand -hex 24`) and never change it after the first deploy:
# the database keeps the password it was created with.
HORATIO_DB_PASSWORD=

# Where people reach the app; used in links in emails and Discord messages.
HORATIO_PUBLIC_URL=https://horatio.lotslarp.org

# Let's Encrypt writes here about the TLS certificate (expiry warnings).
HORATIO_LETSENCRYPT_EMAIL=

# --- Discord (optional: the Discord connector is off without all three) ---------
# The Horatio app at https://discord.com/developers/applications. Register the
# redirect https://horatio.lotslarp.org/api/discord/callback under OAuth2.
HORATIO_DISCORD_CLIENT_ID=
HORATIO_DISCORD_CLIENT_SECRET=
HORATIO_DISCORD_BOT_TOKEN=

# --- Email (optional: the email connector is off without a host and from-address)
HORATIO_SMTP_HOST=
HORATIO_SMTP_PORT=587
HORATIO_SMTP_USERNAME=
HORATIO_SMTP_PASSWORD=
HORATIO_SMTP_STARTTLS=true
HORATIO_SMTP_SSL=false
HORATIO_MAIL_FROM=Horatio <horatio@lotslarp.org>
