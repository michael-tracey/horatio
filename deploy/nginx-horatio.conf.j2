# Written by Horatio's deploy/playbook.yml; do not edit here.
server {
    listen 80;
    server_name {{ domain }};

    # Let's Encrypt's HTTP challenge, for the first certificate and renewals.
    location /.well-known/acme-challenge/ {
        root {{ acme_root }};
    }

{% if tls %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Ubuntu 22.04's nginx (1.18): http2 goes on the listen line.
    listen 443 ssl http2;
    server_name {{ domain }};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:horatio:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    location / {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Portraits are the largest uploads.
        client_max_body_size 10m;
        proxy_read_timeout 60s;
    }
}
