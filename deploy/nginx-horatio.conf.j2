# Written by Horatio's deploy/playbook.yml; do not edit here.

# Links with a secret in their path or query (issue #1060): a password reset, an
# email change, an NPC's claim, an unsubscribe, a calendar, a check-in, Discord's
# callback. The access log writes REDACTED in the secret's place, and only the
# origin of a Referer. These are the patterns in horatio.secret_links, which
# tests/test_secret_links.py checks against these lines: change both together.
map $request_uri $horatio_logged_uri {
    default $request_uri;
    "~^(/(?:reset-password|confirm-email|unsubscribe|claim|check-in|api/auth/reset|api/auth/email-change|api/unsubscribe|api/claims|api/checkin)/)[^/?]+([^?]*)" "$1REDACTED$2";
    "~^(/api/calendar/)[^/?]+(\.ics)" "$1REDACTED$2";
    "~^(/api/discord/callback)\?" "$1?REDACTED";
}

map $http_referer $horatio_logged_referer {
    default "-";
    "~^([a-z][a-z0-9+.-]*://[^/?#]+)" $1;
}

# nginx's usual "combined" format, with those two in place of the request and Referer.
log_format horatio '$remote_addr - $remote_user [$time_local] '
                   '"$request_method $horatio_logged_uri $server_protocol" '
                   '$status $body_bytes_sent "$horatio_logged_referer" "$http_user_agent"';

server {
    listen 80;
    server_name {{ domain }};
    access_log /var/log/nginx/access.log horatio;

    # Let's Encrypt's HTTP challenge, for the first certificate and renewals.
    location /.well-known/acme-challenge/ {
        root {{ acme_root }};
    }

{% if tls %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Ubuntu 22.04's nginx (1.18): http2 goes on the listen line.
    listen 443 ssl http2;
    server_name {{ domain }};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:horatio:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log /var/log/nginx/access.log horatio;
{% endif %}

    # No other site may show Horatio in a frame (issue #1061), and no page tells
    # anyone the address it was opened at, as that may be a link's secret (issue
    # #1060). The app sends these too (horatio.app.SECURITY_HEADERS); nginx drops its
    # copies and sends its own, `always`, so nginx's own error pages (a 502 while the
    # app restarts, a 413 for too big an upload) carry them as well, and there is one
    # of each.
    # Every location below inherits these and HSTS only while it has no add_header
    # of its own: a location that adds one must repeat them all.
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Compress text: the rules catalogue is over half a megabyte of JSON. The app
    # never compresses, so nginx does, for the API and the built frontend alike.
    # Safe from BREACH: see deploy/README.md, "Compression". Ubuntu 22.04's nginx
    # has no Brotli module, so gzip only.
    gzip on;
    gzip_types application/json text/css application/javascript text/javascript
               image/svg+xml application/manifest+json;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_vary on;
    gzip_proxied any;

    location / {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Portraits are the largest uploads, but for a Yorick page (below).
        client_max_body_size 10m;
        proxy_read_timeout 60s;
    }

    # A troupe's Print Characters page from Yorick, zipped with its portraits, for the
    # custodian's import (horatio.yorick_imports): larger than any other upload.
    location ~ ^/api/yorick-imports/[^/]+/page$ {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;
        proxy_read_timeout 60s;
    }

    # The clan crypt card templates for Jyhad cards (horatio.crypt_templates): about
    # 47 MB of PNGs, as one zip or many files.
    location = /api/tools/crypt-templates {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 60m;
        proxy_read_timeout 120s;
    }
}
