# Written by Horatio's deploy/playbook.yml; do not edit here.
server {
    listen 80;
    server_name {{ domain }};

    # Let's Encrypt's HTTP challenge, for the first certificate and renewals.
    location /.well-known/acme-challenge/ {
        root {{ acme_root }};
    }

{% if tls %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Ubuntu 22.04's nginx (1.18): http2 goes on the listen line.
    listen 443 ssl http2;
    server_name {{ domain }};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:horatio:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    # Compress text: the rules catalogue is over half a megabyte of JSON. The app
    # never compresses, so nginx does, for the API and the built frontend alike.
    # Safe from BREACH: see deploy/README.md, "Compression". Ubuntu 22.04's nginx
    # has no Brotli module, so gzip only.
    gzip on;
    gzip_types application/json text/css application/javascript text/javascript
               image/svg+xml application/manifest+json;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_vary on;
    gzip_proxied any;

    location / {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Portraits are the largest uploads, but for a Yorick page (below).
        client_max_body_size 10m;
        proxy_read_timeout 60s;
    }

    # A troupe's Print Characters page from Yorick, zipped with its portraits, for the
    # custodian's import (horatio.yorick_imports): larger than any other upload.
    location ~ ^/api/yorick-imports/[^/]+/page$ {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;
        proxy_read_timeout 60s;
    }

    # The clan crypt card templates for Jyhad cards (horatio.crypt_templates): about
    # 47 MB of PNGs, as one zip or many files.
    location = /api/tools/crypt-templates {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 60m;
        proxy_read_timeout 120s;
    }
}
